# GitHub Actions 自动部署所需 Secrets（Settings → Secrets and variables → Actions）
# 本文件只是说明模板，真正的值配在 GitHub 仓库 Secrets 或本地环境里，不要提交真实值。

# ── 必填 ────────────────────────────────────────────────
CF_API_TOKEN=      # Cloudflare API Token，权限见 README「部署教程」
CF_ACCOUNT_ID=     # Cloudflare Account ID
SITE_DOMAIN=       # 站点主域名，如 mail.example.com
ZONE_NAME=         # 站点域名所在 zone，如 example.com
MAIL_DOMAINS=      # 收信域名，逗号分隔，如 mail.example.com,fademail.example.com
D1_DATABASE_ID=    # D1 数据库 ID（Dashboard → Storage & Databases → D1）

# ── 选填 ────────────────────────────────────────────────
D1_DATABASE_NAME=fademail
WORKER_NAME=fademail
SITE_PASSWORD=     # 站点门禁密码；不配置时全站 503 锁死
ALLOWED_ORIGINS=   # 默认与站点主域名一致
DEFAULT_TTL_HOURS=24
MAX_TTL_HOURS=720
BRAND=FadeMail
